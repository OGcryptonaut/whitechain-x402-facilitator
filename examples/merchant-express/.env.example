# Whitechain x402 Facilitator to verify and settle with (no trailing slash).
FACILITATOR_URL=https://x402-facilitator-production-ff5f.up.railway.app
# Your wallet. Payments go straight here; this server never holds a key.
PAY_TO=0xYourMerchantAddress
# EIP-3009 token to charge in. On Whitechain Sepolia: Inferit Test Credit (ITC).
ASSET_ADDRESS=0x2E672dFE33EA977FD064E01aDe7d8c73B3Be7fBB
ASSET_NAME=Inferit Test Credit
ASSET_VERSION=1
# Price per request in atomic units (ITC has 6 decimals: 10000 = 0.01 ITC).
PRICE_ATOMIC=10000
NETWORK=eip155:1874
PORT=4021
# Optional merchant key for higher facilitator limits.
# FACILITATOR_API_KEY=
