# Throwaway testnet key of the paying wallet. It needs ITC, not WBT.
AGENT_PRIVATE_KEY=0x...
# EIP-3009 token the merchant charges in (Inferit Test Credit on Whitechain Sepolia).
ASSET_ADDRESS=0x2E672dFE33EA977FD064E01aDe7d8c73B3Be7fBB
# The paid endpoint to call.
RESOURCE_URL=http://localhost:4021/weather
RESOURCE_METHOD=GET
# RESOURCE_BODY={"text":"..."}        # JSON body for POST endpoints (merchant-hono)
NETWORK=eip155:1874
# Refuse any single payment above this many atomic units (6 decimals: 100000 = 0.10).
MAX_AMOUNT_ATOMIC=100000
EXPLORER_URL=https://explorer.testnet.whitechain.io
